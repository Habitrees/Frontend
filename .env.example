# Frontend API base. Keep /api when Vite or Nginx proxies requests to Django.
VITE_API_BASE_URL=/api

# Local development proxy target. Publish the backend container on host port 8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Local-only UI simulation. Keep false for real backend integration.
VITE_ENABLE_AUTH_REGISTRATION_MOCK=false
VITE_ENABLE_AUTH_RECOVERY_MOCK=false
